{
    "name": "bun-scripts",
    "displayName": "Bun Scripts",
    "description": "",
    "repository": {
        "type": "git",
        "url": "https://github.com/w0o0o/bun-scripts.git"
    },
    "publisher": "w0o0o",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.82.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "bun-scripts.helloWorld",
                "title": "Hello World"
            }
        ],
        "views": {
            "explorer": [
                {
                    "id": "bunScripts",
                    "name": "Bun Scripts",
                    "iconPath": "bun.svg"
                }
            ]
        }
    },
    "scripts": {
        "build": "esbuild ./src/extension.ts --bundle --outdir=dist --format=cjs --platform=node --external:vscode --sourcemap",
        "watch": "esbuild ./src/extension.ts --bundle --outdir=dist --format=cjs --platform=node --external:vscode --sourcemap --watch",
        "compile": "tsc -noEmit",
        "check": "biome check --write",
        "lint": "biome lint src"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.6",
        "@types/node": "20.2.5",
        "@types/vscode": "^1.82.0",
        "@yuu1111/biome-config": "^1.0.3",
        "@yuu1111/tsconfig": "^1.0.2",
        "esbuild": "^0.25.0",
        "typescript": "^5.1.3"
    }
}
