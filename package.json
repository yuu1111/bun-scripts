{
	"name": "bun-scripts",
	"displayName": "Bun Scripts",
	"publisher": "yuu1111",
	"author": {
		"name": "w0o0o"
	},
	"contributors": [
		{
			"name": "yuu1111"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/yuu1111/bun-scripts.git"
	},
	"version": "1.2.0",
	"engines": {
		"vscode": "^1.118.0"
	},
	"icon": "bun.png",
	"main": "./dist/extension.js",
	"contributes": {
		"views": {
			"explorer": [
				{
					"id": "bunScripts",
					"name": "Bun Scripts"
				}
			]
		},
		"commands": [
			{
				"command": "bunScripts.expandAll",
				"title": "Expand All",
				"icon": "$(expand-all)"
			},
			{
				"command": "bunScripts.collapseAll",
				"title": "Collapse All",
				"icon": "$(collapse-all)"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "bunScripts.expandAll",
					"when": "view == bunScripts",
					"group": "navigation"
				},
				{
					"command": "bunScripts.collapseAll",
					"when": "view == bunScripts",
					"group": "navigation"
				}
			]
		}
	},
	"scripts": {
		"build": "bun scripts/build.ts",
		"watch": "bun scripts/build.ts --watch",
		"typecheck": "tsc -noEmit",
		"lint": "biome check .",
		"format": "biome check --write --unsafe .",
		"deploy": "bun scripts/deploy.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.14",
		"@types/node": "25.6.0",
		"@types/vscode": "^1.118.0",
		"@yuu1111/biome-config": "^1.0.4",
		"@yuu1111/tsconfig": "^1.0.3",
		"esbuild": "^0.28.0",
		"typescript": "^6.0.3"
	}
}
