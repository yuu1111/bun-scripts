{
    "name": "bun-scripts",
    "displayName": "Bun Scripts",
    "publisher": "yuu1111",
    "author": {
        "name": "w0o0o"
    },
    "contributors": [
        {
            "name": "yuu1111"
        }
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/yuu1111/bun-scripts.git"
    },
    "version": "1.0.0",
    "engines": {
        "vscode": "^1.82.0"
    },
    "icon": "bun.png",
    "main": "./dist/extension.js",
    "contributes": {
        "views": {
            "explorer": [
                {
                    "id": "bunScripts",
                    "name": "Bun Scripts",
                    "iconPath": "bun.svg"
                }
            ]
        }
    },
    "scripts": {
        "build": "esbuild ./src/extension.ts --bundle --outdir=dist --format=cjs --platform=node --external:vscode --sourcemap",
        "watch": "esbuild ./src/extension.ts --bundle --outdir=dist --format=cjs --platform=node --external:vscode --sourcemap --watch",
        "compile": "tsc -noEmit",
        "check": "biome check --write",
        "lint": "biome lint src"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.6",
        "@types/node": "25.5.0",
        "@types/vscode": "^1.82.0",
        "@yuu1111/biome-config": "^1.0.3",
        "@yuu1111/tsconfig": "^1.0.2",
        "esbuild": "^0.27.4",
        "typescript": "^5.1.3"
    }
}
